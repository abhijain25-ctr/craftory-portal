datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CLIENT
  EMPLOYEE
}

enum MessageStatus {
  DELIVERED
  HELD_FOR_REVIEW
  REJECTED
  FAILED
}

enum FlagStatus {
  PENDING
  APPROVED
  REJECTED
  DISMISSED
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  realName     String
  role         Role
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  memberships  ProjectMembership[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Project {
  id            String              @id @default(cuid())
  name          String
  code          String              @unique
  description   String              @db.Text
  status        String              @default("ACTIVE")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  memberships   ProjectMembership[]
  conversations Conversation[]

  @@map("projects")
}

model ProjectMembership {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  alias     String    // e.g. "Client Alpha", "Project Specialist Beta"
  role      Role
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messagesSent Message[]

  @@unique([userId, projectId])
  @@map("project_memberships")
}

model Conversation {
  id        String    @id @default(cuid())
  projectId String
  title     String    @default("Confidential Project Stream")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id                 String            @id @default(cuid())
  conversationId     String
  senderMembershipId String
  content            String            @db.Text
  status             MessageStatus     @default(DELIVERED)
  clientTempId       String?           // For idempotent retry & optimistic UI
  rejectionReason    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  conversation     Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMembership ProjectMembership @relation(fields: [senderMembershipId], references: [id], onDelete: Cascade)
  flags            FlaggedMessage[]

  @@map("messages")
}

model ModerationRule {
  id          String   @id @default(cuid())
  category    String   // CONTACT_SHARING, OFF_PLATFORM, COMMERCIAL, ABUSE
  name        String
  pattern     String   @db.Text
  action      String   @default("HOLD") // HOLD or FLAG
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  description String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("moderation_rules")
}

model FlaggedMessage {
  id          String     @id @default(cuid())
  messageId   String
  category    String
  severity    String
  matchedRule String
  reason      String     @db.Text
  status      FlagStatus @default(PENDING)
  adminNotes  String?    @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("flagged_messages")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorRole   String?
  actorEmail  String?
  action      String   // MEMBERSHIP_ASSIGNED, MEMBERSHIP_REVOKED, MESSAGE_APPROVED, etc.
  targetType  String   // PROJECT, MEMBERSHIP, MESSAGE, RULE
  targetId    String?
  details     String   @db.Text
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
